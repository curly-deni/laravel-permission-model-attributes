{
    "name": "curly-deni/laravel-permission-model-attributes",
    "description": "Add permission-aware attributes and static checks to Eloquent models using Laravel's authorization policies.",
    "keywords": [
        "laravel",
        "eloquent",
        "authorization",
        "permissions",
        "model",
        "policy",
        "attributes",
        "access control"
    ],
    "homepage": "https://github.com/curly-deni/laravel-permission-model-attributes",
    "license": "MIT",
    "authors": [
        {
            "name": "Danila Mikhalev",
            "email": "danila@dan-mi.ru",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/contracts": "^10.0||^11.0||^12.0",
        "illuminate/database": "^10.0||^11.0||^12.0",
        "illuminate/support": "^10.0||^11.0||^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14"
    },
    "autoload": {
        "psr-4": {
            "Aesis\\PermissionModelAttributes\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "scripts": {
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aesis\\PermissionModelAttributes\\PermissionModelAttributesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
